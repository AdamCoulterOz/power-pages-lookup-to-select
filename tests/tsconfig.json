{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["DOM", "ES2020"],
    "types": ["node", "jest"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"]
    },
    "typeRoots": ["../node_modules/@types", "node_modules/@types"]
  },
  "include": [
    "**/*.ts",
    "setup.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
