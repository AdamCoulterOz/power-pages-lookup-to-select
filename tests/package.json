{
  "name": "power-pages-lookup-to-select-tests",
  "version": "2.0.0",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jquery": "^3.5.32",
    "@types/node": "^24.2.0",
    "@types/select2": "^4.0.63",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:simple": "tsc simple-test-runner.ts && node simple-test-runner.js",
    "test:structure": "npm run test:simple"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/setup.ts"],
    "testMatch": [
      "<rootDir>/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "../src/**/*.ts",
      "!../src/**/*.d.ts",
      "!../src/index.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/../src/$1",
      "^../src/(.*)$": "<rootDir>/../src/$1"
    },
    "modulePaths": ["<rootDir>/../"],
    "testTimeout": 10000,
    "verbose": true,
    "displayName": "Power Pages Lookup to Select Tests"
  }
}
