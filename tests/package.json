{
  "name": "power-pages-lookup-to-select-tests",
  "version": "2.0.0",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jquery": "^3.5.32",
    "@types/node": "^24.3.0",
    "@types/select2": "^4.0.63",
    "class-transformer": "^0.5.1",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:simple": "tsc simple-test-runner.ts && node simple-test-runner.js",
    "test:structure": "npm run test:simple"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "../src/**/*.ts",
      "!../src/**/*.d.ts",
      "!../src/index.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/../src/$1",
      "^../src/(.*)$": "<rootDir>/../src/$1"
    },
    "modulePaths": [
      "<rootDir>/../"
    ],
    "testTimeout": 10000,
    "verbose": true,
    "displayName": "Power Pages Lookup to Select Tests"
  }
}
